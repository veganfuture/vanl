# Ignore everything except directories
*
!*/

# Ignore dot-prefixed directories at every level
.*/

# Directories to blacklist
bot/run/
bot/tmp/
bot/data
web/node_modules
web/out
**/__pycache__

# Specific files to whitelist
!/.gitignore
!LICENSE

# Allow file formats
!*.nix
!*.md
!*.lock
!*.py
!*.tsx
!*.json
!*.mjs
!*.ts
!*.js
!*.css
!*.nu
!*.png
!*.jpg
!*.gif
!*.ico
!*.svg
!*.toml
!*.manifest
!*.ics
!*.sql
